MINIO_BUCKET_PRIVATE=terabis-private
MINIO_BUCKET_PUBLIC=terabis-public
MINIO_BUCKET_CONFIDENTIAL=terabis-confidential
MINIO_BUCKET_RESTRICTED=terabis-restricted
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_KMS_SECRET_KEY=giftset-dev:ymytN68ifaCKY+kmOVGz98/wmv+ogeEGFz8sKs/SjoA=
MINIO_SSE=AES256
MINIO_OBJECT_LOCK=1
MINIO_SIGNED_URL_TTL=300
