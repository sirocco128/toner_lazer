NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Smart Gift
NEXT_PUBLIC_SITE_DESCRIPTION=ของพรีเมียมครบทุกหมวดสำหรับทุกแบรนด์และทุกแคมเปญ สกรีนโลโก้ได้ สั่งผลิตตามแบบจากจีน แล้วขอใบเสนอราคา
# Phone / email / LINE — leave empty until real contacts are approved (UI hides demo values)
NEXT_PUBLIC_SITE_PHONE_DISPLAY=
NEXT_PUBLIC_SITE_PHONE_HREF=
NEXT_PUBLIC_SITE_EMAIL=
NEXT_PUBLIC_LINE_ID=
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false
# Google Analytics 4 — leave empty until the Measurement ID is ready (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Quote Basket is on by default (set false to hide)
NEXT_PUBLIC_ENABLE_P2_QUOTE_TOOLS=true
# Optional FlipHTML5 public book URL (https://online.fliphtml5.com/... or https://fliphtml5.com/...)
# Deep-link pages with ?p=12 → iframe hash #p=12
# NEXT_PUBLIC_FLIPHTML5_URL=
# Optional PDF catalog for procurement officers (https only)
# NEXT_PUBLIC_FLIPHTML5_PDF_URL=
LEGAL_CONTENT_APPROVED=false
REAL_ASSETS_APPROVED=false
RUNTIME_SECRETS_APPROVED=false

SITE_LEGAL_NAME=บริษัท เทราบิส จำกัด
SITE_TAX_ID=0105556003873
SITE_ENABLE_LOCAL_BUSINESS_SCHEMA=true
SITE_BUSINESS_TYPE=ProfessionalService
SITE_STREET_ADDRESS=50/238 ซอยประชาอุทิศ 72
SITE_ADDRESS_LOCALITY=แขวงทุ่งครุ
SITE_ADDRESS_REGION=เขตทุ่งครุ กรุงเทพมหานคร
SITE_POSTAL_CODE=10140
SITE_COUNTRY_CODE=TH
SITE_LATITUDE=
SITE_LONGITUDE=
SITE_OPENING_HOURS=Mo-Sa 08:30-17:30

# Catalog source: mock | strapi | mysql (alias: nexterp | smartgift)
CMS_MODE=mock
STRAPI_URL=http://localhost:1337
# Browser URL for the ops console “เข้า Strapi” link (defaults to STRAPI_URL + /admin)
# STRAPI_ADMIN_URL=http://localhost:1337/admin
STRAPI_API_TOKEN=
STRAPI_PUBLIC_READ=false
# When true, Strapi/MySQL fetch errors fall back to mock data (useful for partial local CMS setup)
STRAPI_FALLBACK_TO_MOCK=false
STRAPI_FETCH_TIMEOUT_MS=8000
NEXT_IMAGE_REMOTE_URLS=http://127.0.0.1:9000,https://smartgiftthailand.com

# NextERP MySQL staging (products) — used when CMS_MODE=mysql|nexterp
# Default matches docker-compose in ข้อมูลสินค้า ทาราบิท/09_nexterp_mysql_staging
NEXTERP_MYSQL_ENABLED=false
NEXTERP_MYSQL_HOST=127.0.0.1
NEXTERP_MYSQL_PORT=3307
NEXTERP_MYSQL_USER=terabis
NEXTERP_MYSQL_PASSWORD=terabis
NEXTERP_MYSQL_DATABASE=nexterp_staging
# Optional full URL instead of discrete fields:
# NEXTERP_MYSQL_URL=mysql://terabis:terabis@127.0.0.1:3307/nexterp_staging

# SmartGift catalog (sg_offer / sg_offer_price). Independent of NEXTERP customers.
# Refresh from the live site: python scripts/sync-smartgift-website.py
# SMARTGIFT_MYSQL_ENABLED=true
# SMARTGIFT_MYSQL_HOST=127.0.0.1
# SMARTGIFT_MYSQL_PORT=3307
# SMARTGIFT_MYSQL_USER=biz
# SMARTGIFT_MYSQL_PASSWORD=biz_secret
# SMARTGIFT_MYSQL_DATABASE=smartgift

# WMS — apply db/mysql/wms_core.sql then:
#   node scripts/apply-wms-mysql.mjs
#   node scripts/sync-wms-mysql.mjs
# WMS_STORE=mysql


# 1688 factory cost → THB estimates (server-only). See data/1688-offers.example.json
