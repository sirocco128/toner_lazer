REVALIDATE_SECRET=

LEAD_STORAGE_MODE=sqlite
SQLITE_PATH=.data/leads.sqlite
ALLOW_FILE_LEAD_STORAGE=false
LEAD_DATA_DIR=.data
IP_HASH_SECRET=replace-with-at-least-32-random-characters
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MINUTES=15

QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=
QUOTE_WEBHOOK_TIMEOUT_MS=8000
QUOTE_WEBHOOK_MAX_ATTEMPTS=6
QUOTE_WEBHOOK_RETRY_BASE_SECONDS=60
QUOTE_RETRY_BATCH_SIZE=25
CRON_SECRET=

# Partner REST (read-only CRM/ERP/n8n). See docs/PARTNER-API.md
# Option A: bootstrap secret (≥32 chars)
# PARTNER_API_KEY=
# PARTNER_API_SCOPES=quotes:read,orders:read
# PARTNER_API_NAME=env
# PARTNER_API_RATE_LIMIT_MAX=120
# Option B: hashed keys in SQLite
# npm run partner:key -- --name n8n

# Local ops console (/ops) — customer + quote management (not Strapi)
# Demo usernames on /ops/login. Admin password Admin1234 (min 8). Customer: customer / Customer1234
ADMIN_PASSWORD=Admin1234
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=admin
# SuperAdmin uses username `superadmin` and SUPERADMIN_PASSWORD or ADMIN_PASSWORD.
# SUPERADMIN_PASSWORD=
# Extra staff in env (optional bootstrap). Prefer adding people at /ops/users.
# Shared read token for the /sop operations guide SPA (min 16 chars). Not an Ops login.
# Open http://localhost:3000/sop or http://localhost:3000/sop?token=YOUR_TOKEN
# SOP_GUIDE_TOKEN=
# Optional base URL when capturing screenshots: npm run sop:screenshots
# SOP_CAPTURE_BASE_URL=http://127.0.0.1:3000
# SOP_CAPTURE_EMAIL=admin
# Extra staff in env (optional bootstrap). Prefer adding people at /ops/users.
# OPS_USERS=[{"email":"sales@local","password":"sales-pass-12x","role":"sales","name":"เซลล์"},{"email":"view@local","password":"viewer-pass-12","role":"viewer","name":"ดูอย่างเดียว"}]
# Google Sign-In for /ops. Staff Google email must already exist in /ops/users or OPS_USERS.
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/ops/auth/google/callback
# Also add the 127.0.0.1 variant in Google Cloud if you open the app that way.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: restrict the Google account picker to a Workspace domain
# GOOGLE_HOSTED_DOMAIN=terabis.co.th
# Optional: extra email-domain allowlist (comma-separated)
# GOOGLE_ALLOWED_DOMAINS=terabis.co.th,terabis.com

# Gmail SMTP — auto-reply for /contact?intent=message (Google App Password, not account password)
# https://myaccount.google.com/apppasswords
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# MAIL_FROM_NAME=บริษัท เทราบิส จำกัด
# MAIL_SIGN_OFF=Smart Gift

# LINE Official Account — bind buyer chat to a customer contact (ops).
# Local webhook lab (no real Channel): LINE_OA_TEST_MODE=true then open /ops/line-lab
LINE_OA_TEST_MODE=false
LINE_OA_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Webhook URL: {SITE_URL}/api/line/webhook

# Thai billing / PromptPay (company tax ID is the default PromptPay target)
PROMPTPAY_ID=0105556003873
PROMPTPAY_LABEL=พร้อมเพย์บริษัท เทราบิส
# Optional bank account shown next to PromptPay on receipts / pay pages
# BANK_NAME=ธนาคารกสิกรไทย
# BANK_ACCOUNT_NO=
# BANK_ACCOUNT_NAME=บริษัท เทราบิส จำกัด
# VAT is 7% in code. Auto deposit: full amount if grand total ≤ 10,000 THB, else 50%.

# Buyer FAQ widget on the public site (default on). Set false to hide.
NEXT_PUBLIC_ENABLE_BUYER_ASSISTANT=true
# Embed Trantech AI platform widget (appId=terabis) instead of the in-app FAQ assistant.
# Requires the AI gateway at NEXT_PUBLIC_TAIP_ASK_URL. Leave false to keep the native widget.
NEXT_PUBLIC_TAIP_WIDGET=false
NEXT_PUBLIC_TAIP_ASK_URL=http://127.0.0.1:18080/v1/ask
NEXT_PUBLIC_TAIP_WIDGET_SRC=http://127.0.0.1:18080/widget/trantech-ai-chat.js
ASSISTANT_RATE_LIMIT_MAX=12
# Optional text model for FAQ + ops assistant (falls back to canned answers if unset/unavailable)
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

# OpenRouter — Gemini photorealistic mockups (server-only, never commit real keys)
OPENROUTER_API_KEY=
OPENROUTER_MOCKUP_MODEL=google/gemini-2.5-flash-image
OPENROUTER_MOCKUP_ENABLED=true
# Ops /ops/catalog-images uses the chat model + web search to find real 1688/Alibaba photos.
# Optional ASCII-only app title for OpenRouter X-Title
OPENROUTER_APP_TITLE=Smart Gift

# Company lookup on the public quote form:
# 1) Revenue Department VAT (public anonymous SOAP — no key)
# 2) MOC Open Data juristic (DBD register)
# Optional official DBD Open API key: https://openapi.dbd.go.th
DBD_OPENAPI_KEY=
# DBD_OPENAPI_URL=https://openapi.dbd.go.th
LOOKUP_RATE_LIMIT_MAX=30

# smg-ui public BFF (CORS) — https://smartgift.next-dev.net/api/public/*
# Comma-separated browser origins. Dev also allows localhost:8080/5173/4173.
# PUBLIC_SMG_ORIGINS=https://smg.example,http://localhost:8080
# smg-ui: VITE_BRIEF_ENDPOINT=https://smartgift.next-dev.net/api/public/brief

# MinIO (Docker Compose) — catalog images public; customer docs in a private vault
