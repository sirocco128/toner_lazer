# Copy values into the Portainer stack env (do not commit a filled .env.portainer).
# Public hostname: https://smartgift.next-dev.net

NEXT_PUBLIC_SITE_URL=https://smartgift.next-dev.net
NEXT_PUBLIC_SITE_NAME=Smart Gift
NEXT_PUBLIC_SITE_DESCRIPTION=ของพรีเมียมครบทุกหมวดสำหรับทุกแบรนด์และทุกแคมเปญ สกรีนโลโก้ได้ สั่งผลิตตามแบบจากจีน แล้วขอใบเสนอราคา
NEXT_PUBLIC_ALLOW_INDEXING=false
# Google Analytics 4 — leave empty until the Measurement ID is ready (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
CMS_MODE=mock
STRAPI_FALLBACK_TO_MOCK=true
STRAPI_ADMIN_URL=http://192.168.1.30:33137/admin
STRAPI_API_TOKEN=
NEXT_IMAGE_REMOTE_URLS=http://192.168.1.30:33920,https://smartgift.next-dev.net

WEB_HOST_PORT=33100
CMS_HOST_PORT=33137
MINIO_HOST_API_PORT=33920
MINIO_HOST_CONSOLE_PORT=33921
MINIO_REPLICA_API_PORT=33922
MINIO_REPLICA_CONSOLE_PORT=33923

POSTGRES_DB=giftset
POSTGRES_USER=giftset
POSTGRES_PASSWORD=change-me-postgres

MINIO_ROOT_USER=terabis
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_ACCESS_KEY=giftset-app
MINIO_SECRET_KEY=change-me-minio-app
MINIO_BUCKET_PRIVATE=terabis-private
MINIO_BUCKET_PUBLIC=terabis-public
MINIO_BUCKET_CONFIDENTIAL=terabis-confidential
MINIO_BUCKET_RESTRICTED=terabis-restricted
MINIO_PUBLIC_BASE_URL=http://192.168.1.30:33920/terabis-public
MINIO_RETENTION_DAYS=1825

CMS_APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
CMS_API_TOKEN_SALT=tobemodified
CMS_ADMIN_JWT_SECRET=tobemodified
CMS_TRANSFER_TOKEN_SALT=tobemodified
CMS_ENCRYPTION_KEY=tobemodified
CMS_JWT_SECRET=tobemodified

# /ops console — password min 12 chars; session secret min 32 chars
# Google Sign-In from public site: set a real email (not "admin") + OAuth client.
# Redirect URI in Google Cloud: {NEXT_PUBLIC_SITE_URL}/api/ops/auth/google/callback
ADMIN_EMAIL=poramet128@gmail.com
ADMIN_NAME=ผู้ดูแล
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Extra staff bootstrap (prefer /ops/users after first login):
# OPS_USERS=[{"email":"sales@company.com","password":"sales-pass-12x","role":"sales","name":"เซลล์"}]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: GOOGLE_HOSTED_DOMAIN=terabis.co.th
# Optional: GOOGLE_ALLOWED_DOMAINS=gmail.com,terabis.co.th
IP_HASH_SECRET=replace-with-at-least-32-random-characters
REVALIDATE_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Tunnel — enable compose profile `tunnel` in Portainer after pasting token
TUNNEL_TOKEN=

# TranTech AI knowledge sync (/ops/knowledge-sync) — point at PC running internal-api
# Do not use 127.0.0.1 inside the container. Example LAN: http://192.168.1.35:8100
TRANTECH_INTERNAL_API_URL=http://192.168.1.35:8100
TRANTECH_INTERNAL_API_TOKEN=phase1-internal-api-token
# Leave empty on Linux/NAS unless the TranTech repo is mounted into the container
TRANTECH_ROOT=

# SmartGift MySQL runs in this compose stack. Inside containers use the service name.
SMARTGIFT_MYSQL_ENABLED=true
SMARTGIFT_MYSQL_HOST=mysql
SMARTGIFT_MYSQL_PORT=3306
SMARTGIFT_MYSQL_PUBLISH_PORT=3307
SMARTGIFT_MYSQL_USER=biz
SMARTGIFT_MYSQL_PASSWORD=biz_secret
SMARTGIFT_MYSQL_DATABASE=smartgift

# smg-ui public BFF (CORS) on this host
PUBLIC_SMG_ORIGINS=https://smartgift.next-dev.net,http://localhost:8080
