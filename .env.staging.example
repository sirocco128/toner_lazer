# Staging environment — copy to .env.staging (gitignored)
# Fill from intake/sprint2-intake.json via: npm run sprint2:apply-intake -- --target .env.staging
# Until intake is APPROVED, this example keeps demo-safe defaults (noindex, mock CMS).

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=GiftPro Asia (Staging)
NEXT_PUBLIC_SITE_DESCRIPTION=รับผลิต Gift Set ของขวัญพรีเมียม — สภาพแวดล้อม staging
NEXT_PUBLIC_SITE_PHONE_DISPLAY=02-000-0000
NEXT_PUBLIC_SITE_PHONE_HREF=tel:+6620000000
NEXT_PUBLIC_SITE_EMAIL=staging@example.com
NEXT_PUBLIC_LINE_ID=@giftproasia
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@giftproasia
NEXT_PUBLIC_ALLOW_INDEXING=false
# Google Analytics 4 — leave empty until the Measurement ID is ready (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_P2_QUOTE_TOOLS=false
NEXT_PUBLIC_ENABLE_BUYER_ASSISTANT=true
NEXT_PUBLIC_TAIP_WIDGET=false

LEGAL_CONTENT_APPROVED=false
REAL_ASSETS_APPROVED=false
RUNTIME_SECRETS_APPROVED=false

SITE_LEGAL_NAME=
SITE_TAX_ID=
SITE_ENABLE_LOCAL_BUSINESS_SCHEMA=false
SITE_BUSINESS_TYPE=ProfessionalService
SITE_STREET_ADDRESS=
SITE_ADDRESS_LOCALITY=
SITE_ADDRESS_REGION=
SITE_POSTAL_CODE=
SITE_COUNTRY_CODE=TH
SITE_OPENING_HOURS=

CMS_MODE=mock
STRAPI_URL=http://host.docker.internal:1337
# Clickable admin URL in the ops console (host.docker.internal is not a browser host)
# STRAPI_ADMIN_URL=http://localhost:1337/admin
STRAPI_API_TOKEN=
STRAPI_PUBLIC_READ=false
STRAPI_FALLBACK_TO_MOCK=true
STRAPI_FETCH_TIMEOUT_MS=8000
NEXT_IMAGE_REMOTE_URLS=

# 1688 estimates (staging). Keep disabled until offers + Strapi write are verified.
ALIBABA_ESTIMATES_ENABLED=false
ALIBABA_OFFERS_PATH=data/1688-offers.json
ALIBABA_FX_CNY_THB=5
ALIBABA_PUBLIC_IMAGES=false
ALIBABA_IMAGES_LICENSED=false
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=

REVALIDATE_SECRET=replace-with-staging-revalidate-secret-min-32-chars
IP_HASH_SECRET=replace-with-staging-ip-hash-secret-min-32-chars

LEAD_STORAGE_MODE=sqlite
SQLITE_PATH=.data/leads.sqlite
ALLOW_FILE_LEAD_STORAGE=false
LEAD_DATA_DIR=.data
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MINUTES=15

QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=
CRON_SECRET=
# PARTNER_API_KEY=

# MinIO — staging compose maps API to localhost:9010 / console 9011.
# Inside the web container, docker-compose.staging.yml overrides ENDPOINT to http://minio:9000
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_ROOT_USER=terabis
MINIO_ROOT_PASSWORD=terabisMinioDev1
MINIO_ACCESS_KEY=giftset-app
MINIO_SECRET_KEY=giftsetAppDevKey1
MINIO_BUCKET_PRIVATE=terabis-private
MINIO_BUCKET_PUBLIC=terabis-public
MINIO_BUCKET_CONFIDENTIAL=terabis-confidential
MINIO_BUCKET_RESTRICTED=terabis-restricted
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_SSE=AES256
MINIO_OBJECT_LOCK=1
MINIO_KMS_SECRET_KEY=giftset-dev:ymytN68ifaCKY+kmOVGz98/wmv+ogeEGFz8sKs/SjoA=
MINIO_SIGNED_URL_TTL=300
MINIO_RETENTION_DAYS=1825
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9010/terabis-public
MINIO_CMS_ROOT=cms
MINIO_REPLICA_ENDPOINT=http://127.0.0.1:9012
