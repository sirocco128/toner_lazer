# One-shot schema migrate for Compose. Does not start the web app.

FROM node:22-alpine
WORKDIR /app

RUN addgroup -g 1001 -S nodejs \
  && adduser -S -u 1001 -G nodejs nextjs \
  && npm init -y >/dev/null \
  && npm install --omit=dev mysql2@3.14.1

COPY db ./db
COPY scripts/migrate.mjs ./scripts/migrate.mjs
COPY scripts/apply-wms-mysql.mjs ./scripts/apply-wms-mysql.mjs
COPY scripts/migrate-all.mjs ./scripts/migrate-all.mjs

RUN mkdir -p /app/.data \
  && chown -R nextjs:nodejs /app/.data /app/scripts /app/db /app/node_modules

USER nextjs
ENV NODE_ENV=production \
    SQLITE_PATH=/app/.data/leads.sqlite

ENTRYPOINT ["node", "scripts/migrate-all.mjs"]
