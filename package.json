{
  "name": "premium-giftset-web",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/load-env.mjs next dev",
    "build": "npm run validate:env && next build",
    "start": "node scripts/load-env.mjs next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:all": "node scripts/migrate-all.mjs",
    "db:migrate:compose": "docker compose -f docker-compose.staging.yml run --rm migrate",
    "wms:mysql:apply": "node scripts/apply-wms-mysql.mjs",
    "wms:mysql:sync": "node scripts/sync-wms-mysql.mjs",
    "partner:key": "node scripts/partner-api-key.mjs",
    "cms:bootstrap": "node scripts/bootstrap-strapi.mjs",
    "backup:leads": "node scripts/backup-leads.mjs",
    "restore:leads": "node scripts/restore-leads.mjs",
    "lhci": "lhci autorun",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "check:demo": "node scripts/check-demo-placeholders.mjs",
    "sprint2:preflight": "node scripts/sprint2-preflight.mjs",
    "sprint2:apply-intake": "node scripts/apply-sprint2-intake.mjs",
    "sprint2:staging-demo": "node scripts/sprint2-staging-demo.mjs",
    "staging:up": "node scripts/staging-up.mjs",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "uat:auto": "node scripts/uat-auto.mjs",
    "build:standalone": "npm run build && node scripts/prepare-standalone.mjs",
    "cms:setup": "node scripts/cms-local-setup.mjs",
    "cms:seed": "node scripts/seed-strapi-content.mjs",
    "articles:seed-factual": "node scripts/seed-factual-article-drafts.mjs",
    "articles:schedule": "node scripts/seed-scheduled-articles.mjs",
    "images:stock": "node scripts/fetch-stock-images.mjs",
    "alibaba:sync": "node scripts/sync-1688-strapi.mjs",
    "1688:sync": "node scripts/sync-1688-strapi.mjs",
    "minio:up": "docker compose up -d minio minio-replica minio-init minio-mirror",
    "minio:down": "docker compose stop minio minio-replica minio-mirror",
    "vault:up": "docker compose up -d minio minio-replica minio-init minio-mirror clamav",
    "cms:media:minio": "node scripts/migrate-strapi-media-to-minio.mjs",
    "sop:screenshots": "node --experimental-strip-types scripts/capture-sop-screenshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.41.0",
    "mermaid": "^11.17.2",
    "mysql2": "^3.14.1",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
